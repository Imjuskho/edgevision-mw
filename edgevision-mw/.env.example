# =============================================================================
# EdgeVision-MW Control Plane — Environment Variables
# Copy to .env and configure for your environment.
# Generate SECRET_KEY: openssl rand -hex 32
# =============================================================================

# --- Environment ---
# Set to "production" for JSON logging and hardened defaults
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=edgevision
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=edgevision_mw
# DATABASE_URL is auto-built from the above; override only for external databases
# DATABASE_URL=postgresql+asyncpg://edgevision:CHANGE_ME@postgres:5432/edgevision_mw

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
MINIO_BUCKET=edgevision-data-lake
# Set to true in production with TLS-terminated MinIO
MINIO_SECURE=false

# --- JWT / Auth ---
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
# Generate one: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Celery task queue ---
CELERY_BROKER_URL=redis://redis:6379/1

# --- Node Fleet ---
NODE_HEARTBEAT_INTERVAL=30
# Minimum inter-annotator agreement for certification
ANNOTATION_TARGET_IAA=0.96

# --- Economics ---
# Minimum daily wage for annotators (Malawian Kwacha)
MINIMUM_ANNOTATOR_WAGE_MWK=5000
# MWK to USD conversion rate
MWK_TO_USD_RATE=0.0006

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
